{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "dskb-v2.vercel.app"
        }
      ],
      "destination": "/v2.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
